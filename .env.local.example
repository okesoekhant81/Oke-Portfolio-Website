# Copy this file to .env.local for local development.
# In production, set these in the Vercel dashboard instead.

# A password for /admin. Pick something strong — this is the only thing
# standing between the public and your content.
ADMIN_PASSWORD=

# Any long random string, used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Injected automatically once you connect a Vercel Blob store to this
# project (Vercel dashboard -> Storage -> Create -> Blob, Public access).
# You shouldn't need to set this by hand.
# BLOB_READ_WRITE_TOKEN=

# Any long random string, used to keep content file paths inside the Blob
# store from being guessable (the store itself is public — see
# lib/blobStore.js). Generate one with: openssl rand -base64 24
BLOB_PATH_SECRET=

# A Postgres connection string (e.g. from Supabase) — required for
# students/inquiries/admin-users, which live in Postgres rather than Blob
# since they're the actual PII this app handles. Use the pooled connection
# string (pgbouncer, port 6543) here; everything else stays on Blob.
POSTGRES_URL=

# Email (Resend) — powers the registration confirmation, class reminders,
# and the "new inquiry" admin notification. All of these silently no-op
# until both RESEND_API_KEY and EMAIL_FROM are set, same as Blob.
# Get a key at https://resend.com — EMAIL_FROM must be an address on a
# domain you've verified there (e.g. hello@okesoekhant.com).
RESEND_API_KEY=
EMAIL_FROM=

# Where the "new inquiry" and "class is tomorrow" admin notifications are
# sent. Leave empty to disable just the admin-facing emails while keeping
# registrant confirmations/reminders on.
ADMIN_NOTIFY_EMAIL=

# Any long random string — required so the daily class-reminder cron
# (Vercel Cron calling /api/cron/class-reminders) can't be triggered by
# anyone else who finds the URL. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Meta Conversions API (server-side event sends for CompleteRegistration +
# Purchase — see lib/metaCapi.js). The Pixel/dataset id itself is public
# and lives as a constant in lib/site.js; this token is the actual secret —
# get it from Events Manager -> Settings -> Conversions API -> Generate
# access token. Both CompleteRegistration and Purchase silently no-op
# until this is set, same as email/Blob.
META_CAPI_ACCESS_TOKEN=

# Optional. Set to the code shown in Events Manager -> Test Events while
# verifying in production, then unset it — events sent with a test code
# land in the Test Events panel instead of counting toward ad optimization.
META_TEST_EVENT_CODE=
