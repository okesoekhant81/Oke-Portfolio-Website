# Copy this file to .env.local for local development.
# In production, set these in the Vercel dashboard instead.

# A password for /admin. Pick something strong — this is the only thing
# standing between the public and your content.
ADMIN_PASSWORD=

# Any long random string, used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# These are injected automatically once you connect a Vercel KV store and a
# Vercel Blob store to this project (Vercel dashboard -> Storage -> Create).
# You shouldn't need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
