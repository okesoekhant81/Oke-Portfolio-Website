# Copy this file to .env.local for local development.
# In production, set these in the Vercel dashboard instead.

# A password for /admin. Pick something strong — this is the only thing
# standing between the public and your content.
ADMIN_PASSWORD=

# Any long random string, used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Injected automatically once you connect a Vercel Blob store to this
# project (Vercel dashboard -> Storage -> Create -> Blob, Public access).
# You shouldn't need to set this by hand.
# BLOB_READ_WRITE_TOKEN=
